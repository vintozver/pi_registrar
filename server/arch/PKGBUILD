pkgname=pi-registrar-server
pkgver=1.0.0
pkgrel=1
pkgdesc="Server for registering host addresses"
arch=('any')
url="https://github.com/vintozver/pi_registrar"
license=('unknown')
depends=('python' 'python-cherrypy' 'python-cryptography' 'python-dnspython'
         'python-pyjwt' 'python-yaml' 'python-dateutil')
makedepends=('git' 'python-build' 'python-installer' 'python-setuptools' 'python-wheel')
backup=('etc/pi-registrar/server/config.yaml')

_commit=master
source=("pi_registrar::git+${url}.git#commit=${_commit}")
sha256sums=('SKIP')

build() {
    cd "$srcdir/pi_registrar/server"
    python -m build --wheel --no-isolation
}

package() {
    cd "$srcdir/pi_registrar/server"

    python -m installer --destdir="$pkgdir" dist/*.whl
    install -Dm644 debian/pi-registrar-server.service \
        "$pkgdir/usr/lib/systemd/system/pi-registrar-server.service"
    install -Dm640 debian/server-config.yaml \
        "$pkgdir/etc/pi-registrar/server/config.yaml"
    install -Dm644 arch/pi-registrar-server.sysusers \
        "$pkgdir/usr/lib/sysusers.d/pi-registrar-server.conf"
    install -Dm644 arch/pi-registrar-server.tmpfiles \
        "$pkgdir/usr/lib/tmpfiles.d/pi-registrar-server.conf"
}
